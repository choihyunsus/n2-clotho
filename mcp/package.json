{
  "name": "n2-clotho",
  "version": "4.1.0",
  "description": "N2 rule parser, validator, state-machine runtime and six-target code generator with bundled WASM and MCP tools",
  "main": "index.js",
  "type": "commonjs",
  "files": [
    "index.js",
    "index.d.ts",
    "input.js",
    "server.js",
    "tools/*.js",
    "wasm/*.js",
    "wasm/*.wasm",
    "wasm/*.d.ts",
    "README.md",
    "README.ko.md",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSE-APACHE",
    "LICENSE-DAEBUNG"
  ],
  "scripts": {
    "start": "node server.js",
    "start:sse": "node server.js --sse",
    "build:compiler": "cargo build --manifest-path ../compiler/Cargo.toml --release --locked",
    "test": "node --test tests/*.test.js",
    "prepack": "npm test"
  },
  "keywords": [
    "mcp",
    "compiler",
    "ai-governance",
    "behavioral-contract",
    "multi-target",
    "code-generation",
    "state-machine",
    "n2"
  ],
  "author": "N2 <lagi0730@gmail.com>",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/choihyunsus/n2-clotho"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "types": "index.d.ts"
}
